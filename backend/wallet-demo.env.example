# Non-secret Phase 1 settings: copy into the TEST environment only, not production.
# Keep the existing MONGODB_URI/auth settings for your designated test database.
NODE_ENV=development
WALLET_DEMO_ENABLED=true
WALLET_DEMO_ALL_USERS=true
WALLET_DEMO_SELF_SETTLE=true
# Exact IDs returned by login for dedicated test accounts, comma-separated.
# This list is used only when WALLET_DEMO_ALL_USERS is not true.
WALLET_DEMO_USER_IDS=replace-with-test-user-a-id,replace-with-test-user-b-id
