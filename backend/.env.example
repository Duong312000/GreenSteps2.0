# Runtime config is read from ../server_mongodb/.env by the backend entrypoint.
PORT=5055
MONGODB_URI=mongodb://127.0.0.1:27017/GreenStepsDataMigrated
SESSION_SECRET=replace-with-a-local-secret
JWT_SECRET=replace-with-a-local-secret
CLIENT_URL=http://localhost:4200

# Configure OAuth in server_mongodb/.env (the active runtime).
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=
