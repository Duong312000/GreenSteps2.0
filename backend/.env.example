# backend/.env takes precedence; server_mongodb/.env supplies missing values.
PORT=5055
MONGODB_URI=mongodb://127.0.0.1:27018/GreenStepsDataMigrated?replicaSet=rs0
# Dedicated local replica set for integration tests only; do not point this at production.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27019/?replicaSet=rs0
MONGODB_COLLECTION_PREFIX=app_
# Only the migration tool reads this. The running API never connects to PostgreSQL.
DATABASE_URL=
# PostgreSQL TLS uses certificate verification by default.
PGSSL=true
PGSSL_CA_FILE=
SESSION_SECRET=replace-with-a-local-secret
JWT_SECRET=replace-with-a-local-secret
CLIENT_URL=http://localhost:4200


# OAuth settings (backend/.env takes precedence).
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=

GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Express-only n8n adapter. Never copy these secrets into Angular.
N8N_WEBHOOK_URL=https://n8n.ba-ailab.com/webhook/greensteps-web2-agent-v3-fast
N8N_AUTH_HEADER_NAME=X-GreenSteps-Agent-Key
N8N_AUTH_HEADER_VALUE=
N8N_RESPONSE_FIELD=output
N8N_CHAT_TIMEOUT_MS=35000
N8N_CATALOG_ENABLED=true
N8N_CATALOG_CACHE_MS=30000
